# OAuth client credentials issued by formbase's /oauth/register (confidential
# client, token_endpoint_auth_method=client_secret_post). Set in Zapier with:
#   zapier env:set <version> CLIENT_ID=... CLIENT_SECRET=... BASE_URL=...
# Remember to seed oauthClient table: npx convex run internal/oauthClients:seedZapierOAuthClient \
# '{"redirectUris":["https://zapier.com/dashboard/auth/oauth/return/.../"]}' --prod
CLIENT_ID=fboc_REPLACE_WITH_REGISTERED_CLIENT_ID
CLIENT_SECRET=fbocs_REPLACE_WITH_REGISTERED_CLIENT_SECRET
