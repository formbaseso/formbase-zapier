  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zapier-platform-core": "19.0.0"
  },
  "devDependencies": {
    "zapier-platform-cli": "^19.0.0",
    "jest": "^29.7.0",
    "nock": "^13.5.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
