{
  "name": "formbase-zapier",
  "version": "1.3.1",
  "description": "Official formbase integration for Zapier — resume Zaps when a customer completes a request or submits a form.",
  "license": "MIT",
  "homepage": "https://formbase.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formbaseso/formbase-zapier.git"
  },
  "bugs": {
